{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lzhs1995/clauder-rstudio-workbench/schemas/comparegroups-batch-manifest-1.0.json",
  "title": "compareGroups Guide batch manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "batch_id", "jobs"],
  "properties": {
    "manifest_version": {"const": "1.0"},
    "batch_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "jobs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "spec_path", "output_dir"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
          "spec_path": {"type": "string", "minLength": 1},
          "output_dir": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"}
        }
      }
    }
  }
}
