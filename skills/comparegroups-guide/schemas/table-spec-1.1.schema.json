{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lzhs1995/clauder-rstudio-workbench/schemas/table-spec-1.1.json",
  "title": "compareGroups Guide table specification 1.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_version", "analysis_id", "input", "analysis", "blocks", "display", "outputs"],
  "properties": {
    "spec_version": {"const": "1.1"},
    "analysis_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "format"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "format": {"enum": ["auto", "dta", "sav", "csv", "tsv", "rds"]},
        "id": {"type": ["string", "null"]},
        "time": {"type": ["string", "null"]}
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "continuous_digits": {"type": "integer", "minimum": 0, "maximum": 8, "default": 3},
        "categorical_digits": {"type": "integer", "minimum": 0, "maximum": 8, "default": 2},
        "p_digits": {"type": "integer", "minimum": 0, "maximum": 8, "default": 3},
        "include_missing": {"type": "boolean", "default": false}
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group", "panel_mode", "subset"],
      "properties": {
        "group": {"type": ["string", "null"]},
        "panel_mode": {"enum": ["cross_section", "dual", "pooled_compatibility"]},
        "subset": {"type": ["string", "null"]},
        "note": {"type": ["string", "null"]},
        "group_reference": {"type": ["string", "null"]},
        "group_levels": {"$ref": "#/$defs/levels"},
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "subset"],
            "properties": {
              "id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
              "label": {"type": ["string", "null"]},
              "subset": {"type": ["string", "null"]}
            }
          }
        },
        "attrition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["baseline_values", "followup_values"],
          "properties": {
            "baseline_values": {"$ref": "#/$defs/nonEmptyScalars"},
            "followup_values": {"$ref": "#/$defs/nonEmptyScalars"},
            "group_name": {"type": "string", "minLength": 1, "default": "retention_status"},
            "retained_label": {"type": "string", "minLength": 1, "default": "Retained"},
            "deleted_label": {"type": "string", "minLength": 1, "default": "Deleted"}
          }
        }
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "variables"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "variables": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "type", "method"],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "type": {"enum": ["continuous", "categorical"]},
                "method": {"enum": ["normal", "nonnormal", "categorical"]},
                "digits": {"type": "integer", "minimum": 0, "maximum": 8},
                "label": {"type": ["string", "null"]},
                "include_missing": {"type": "boolean"},
                "reference": {"type": ["string", "null"]},
                "levels": {"$ref": "#/$defs/levels"}
              }
            }
          }
        }
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": ["show_all", "show_n", "show_p_overall", "show_p_multiple", "show_p_trend"],
      "properties": {
        "show_all": {"type": "boolean"},
        "show_n": {"type": "boolean"},
        "show_p_overall": {"type": "boolean"},
        "show_p_multiple": {"type": "boolean"},
        "show_p_trend": {"type": "boolean"},
        "p_digits": {"type": "integer", "minimum": 0, "maximum": 8},
        "hide_no": {
          "oneOf": [
            {"type": "null"},
            {"type": "string"},
            {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
          ]
        },
        "compatibility_export2word": {"type": "boolean", "default": false},
        "docx": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "font_family": {"type": "string", "minLength": 1, "default": "Times New Roman"},
            "font_size": {"type": "number", "exclusiveMinimum": 0, "maximum": 72, "default": 10},
            "orientation": {"enum": ["portrait", "landscape"], "default": "portrait"},
            "repeat_header": {"type": "boolean", "default": true},
            "title": {"type": ["string", "null"]},
            "footnote": {"type": ["string", "null"]},
            "column_widths": {
              "type": ["array", "null"],
              "minItems": 1,
              "items": {"type": "number", "exclusiveMinimum": 0}
            }
          }
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stem", "formats"],
      "properties": {
        "stem": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]*$"},
        "formats": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "items": {"enum": ["docx", "csv", "rds"]}
        }
      }
    }
  },
  "$defs": {
    "scalar": {"type": ["string", "number", "integer", "boolean"]},
    "nonEmptyScalars": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/scalar"}},
    "levels": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "label"],
            "properties": {
              "value": {"$ref": "#/$defs/scalar"},
              "label": {"type": "string", "minLength": 1}
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"analysis": {"required": ["attrition"]}}},
      "then": {
        "properties": {
          "input": {"required": ["path", "format", "id", "time"]}
        }
      }
    }
  ]
}
