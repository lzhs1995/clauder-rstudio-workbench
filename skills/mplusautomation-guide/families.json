      "config_example": null,
      "docs": [
        "references/archived-replay-runtime.md",
        "references/durable-windows-worker.md"
      ]
    },
    "mplus_object_mapping": {
      "label": "mplusObject 换名映射",
      "entry_functions": [
        "scripts/model_mapping.R:mplus_from_mapping",
        "scripts/mplus_workflow.R:run_mplus_model",
        "scripts/growth_time_basis.R:growth_time_basis"
      ],
      "config_example": null,
      "docs": [
        "references/reusable-models.md",
        "references/cross-dataset-migration.md"
      ]
