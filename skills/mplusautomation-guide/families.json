{
  "schema_version": 1,
  "description": "mplusautomation-guide 模型家族注册表。路径相对 skill 根目录。不写估计值、个体值、ID、本机路径或样本量以外的描述统计。人读视图由 scripts/family_registry.py render 生成。",
  "routes": {
    "apim_v1_config": {
      "label": "APIM v1 配置编译器",
      "entry_functions": [
        "scripts/workflow.R:validate_apim_config",
        "scripts/workflow.R:run_apim_workflow"
      ],
      "config_example": "assets/example_config.R",
      "docs": [
        "references/executable-workflow.md"
      ]
    },
    "apim_v2_config": {
      "label": "APIM v2 配置编译器（schema_version = 2）",
      "entry_functions": [
        "scripts/apim_v2_config.R:plan_apim_workflow",
        "scripts/apim_v2_runtime.R:run_apim_workflow_v2"
      ],
      "config_example": "assets/example_config_v2.R",
      "docs": [
        "references/apim-v2-implementation-acceptance.md",
        "references/apim-v2-data-adapter.md"
      ]
    },
    "template_bundle": {
      "label": "已审 [[init]] 模板的保持式编译",
      "entry_functions": [
        "scripts/compile_template_bundle.R:compile_mplus_template_bundle",
        "scripts/template_contracts.py:manifest_contract"
      ],
      "config_example": null,
      "docs": [
        "references/template-preserving-workflow.md"
      ]
    },
    "archived_replay": {
      "label": "归档 DAT/INP 回放",
      "entry_functions": [
        "scripts/durable_mplus_worker.py:main",
        "scripts/verify_saved_batch.py:main"
      ],
      "config_example": null,
      "docs": [
        "references/archived-replay-runtime.md",
        "references/durable-windows-worker.md"
      ]
    },
    "mplus_object_mapping": {
      "label": "mplusObject 换名映射",
      "entry_functions": [
        "scripts/model_mapping.R:mplus_from_mapping",
        "scripts/mplus_workflow.R:run_mplus_model",
        "scripts/growth_time_basis.R:growth_time_basis",
        "scripts/growth_time_basis.R:growth_model_syntax",
        "scripts/growth_time_basis.R:check_growth_statements",
        "scripts/growth_time_basis.R:parallel_growth_model_syntax"
      ],
      "config_example": null,
      "docs": [
        "references/reusable-models.md",
        "references/cross-dataset-migration.md"
      ]
    },
    "external_project": {
      "label": "外部研究项目驱动 + 共用执行层",
      "entry_functions": [
        "scripts/run_rstudio_mplus_batch.R:run_rstudio_mplus_batch",
        "scripts/run_rstudio_family_queue.R:run_rstudio_family_queue"
      ],
      "config_example": null,
      "docs": [
        "references/rstudio-two-entry-workflow.md",
        "references/pp-lgcm-worked-example.md"
      ]
    },
    "mplus_object_syntax": {
      "label": "mplusObject()/mplusModeler() 语法生成（第七章混合模型；显式规格，不是通用编译器）",
      "entry_functions": [
        "scripts/ch7_mixture_syntax.R:ch7_mixture_object",
        "scripts/ch7_mixture_tools.R:ch7_classify_inp",
        "scripts/ch7_mixture_tools.R:ch7_enumeration_table",
        "scripts/ch7_mixture_tools.R:ch7_step3_binding"
      ],
      "config_example": null,
      "docs": [
        "references/chapter7-source-variable-contract-20261104.md",
        "references/lpa-lca-workflow.md"
      ]
    },
    "r_glm_moderation": {
      "label": "R 静态调节：显式配置 → glm + 聚类 HC0 → 简单斜率与绘图",
      "entry_functions": [
        "scripts/ch5_moderation_route.R:ch5_moderation_spec",
        "scripts/ch5_moderation_route.R:ch5_fit_moderation_spec",
        "scripts/ch5_moderation_route.R:ch5_simple_slopes",
        "scripts/ch5_moderation_route.R:ch5_plot_simple_slopes"
      ],
      "config_example": null,
      "docs": [
        "references/mediation-moderation-workflow.md"
      ]
    }
  },
