{
  "schema_version": 1,
  "description": "mplusautomation-guide 模型家族注册表。路径相对 skill 根目录。不写估计值、个体值、ID、本机路径或样本量以外的描述统计。人读视图由 scripts/family_registry.py render 生成。",
  "routes": {
